{
  "name": "Notification",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "spending_alert",
        "savings_milestone",
        "fd_suggestion",
        "weekly_challenge",
        "ai_reminder",
        "commitment_warning",
        "risk_alert"
      ]
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "icon": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "message",
    "category"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}

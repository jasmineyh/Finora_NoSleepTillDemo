{
  "name": "Commitment",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "target_amount": {
      "type": "number"
    },
    "spending_cap_percent": {
      "type": "number"
    },
    "days_total": {
      "type": "number",
      "default": 30
    },
    "days_remaining": {
      "type": "number"
    },
    "current_progress": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "on_track",
        "at_risk",
        "broken",
        "completed"
      ],
      "default": "on_track"
    },
    "category": {
      "type": "string",
      "enum": [
        "savings",
        "spending_cap",
        "no_spend",
        "food_delivery",
        "subscription",
        "custom"
      ],
      "default": "savings"
    },
    "maya_note": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}